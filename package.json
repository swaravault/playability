    "android:run": "./build.py android:run",
    "android:apk": "./build.py android:apk",
    "ios:setup": "./build.py ios:setup",
    "ios:run": "./build.py ios:run",
    "mac:setup": "./build.py mac:setup",
    "mac:dev": "./build.py mac:dev",
    "mac:dmg": "./build.py mac:dmg",
    "win:setup": "./build.py win:setup",
    "win:dev": "./build.py win:dev",
    "win:nsis": "./build.py win:nsis",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\""
